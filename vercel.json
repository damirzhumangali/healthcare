{
  "rewrites": [
    {
      "source": "/body",
      "destination": "/body/index.html"
    },
    {
      "source": "/privacy",
      "destination": "/privacy/index.html"
    },
    {
      "source": "/terms",
      "destination": "/terms/index.html"
    },
    {
      "source": "/medical-disclaimer",
      "destination": "/medical-disclaimer/index.html"
    },
    {
      "source": "/auth/callback",
      "destination": "/index.html"
    },
    {
      "source": "/auth/vk/callback",
      "destination": "/index.html"
    },
    {
      "source": "/auth/(.*)",
      "destination": "https://healthcare-backend-telt.onrender.com/auth/$1"
    },
    {
      "source": "/api/(.*)",
      "destination": "https://healthcare-backend-telt.onrender.com/api/$1"
    },
    {
      "source": "/login",
      "destination": "/index.html"
    },
    {
      "source": "/register",
      "destination": "/index.html"
    },
    {
      "source": "/appointments/new",
      "destination": "/index.html"
    },
    {
      "source": "/doctor",
      "destination": "/index.html"
    },
    {
      "source": "/admin",
      "destination": "/index.html"
    },
    {
      "source": "/admin/aimar",
      "destination": "/index.html"
    },
    {
      "source": "/admin/request/:id",
      "destination": "/index.html"
    },
    {
      "source": "/admin/doctor-schedule",
      "destination": "/index.html"
    },
    {
      "source": "/admin/ward-consults",
      "destination": "/index.html"
    },
    {
      "source": "/app",
      "destination": "/index.html"
    },
    {
      "source": "/app/measurements/:id",
      "destination": "/index.html"
    },
    {
      "source": "/scan/:deviceId",
      "destination": "/index.html"
    },
    {
      "source": "/pair",
      "destination": "/index.html"
    },
    {
      "source": "/pair/:deviceId/:pairingToken",
      "destination": "/index.html"
    }
  ]
}
