# Local development backend.
# For Vercel production, either:
# 1. set VITE_API_BASE_URL to your deployed backend URL, or
# 2. leave it unset if the API is served from the same domain.
VITE_API_BASE_URL=http://localhost:4015

# Optional external link for the "Configure BMO" item in the admin panel.
VITE_BMO_SETTINGS_URL=

# Public frontend URL used for QR links, canonical URLs, and sitemap generation.
# Set this in production, for example:
# VITE_PUBLIC_APP_URL=https://healthcare-bmo.vercel.app
VITE_PUBLIC_APP_URL=https://healthcare.kz

# Google OAuth Client ID for the doctor dashboard (/doctor).
# Create at: https://console.cloud.google.com → APIs & Services → Credentials → OAuth 2.0 Client ID
# Authorized JS origins: https://healthcare.kz, http://localhost:5173
VITE_GOOGLE_CLIENT_ID=
